# Copy to .env and adjust. Placeholders only: never commit real secrets.

# Application
APP_ENV=local
LOG_LEVEL=INFO
# Resume uploads: maximum size in bytes (5 MB) and where original files are kept.
# Docker Compose overrides the directory with its persistent volume (/data/resumes).
RESUME_MAX_UPLOAD_BYTES=5242880
RESUME_STORAGE_DIR=data/resumes
# Inside Docker Compose the database host is "db". On the host machine use "localhost".
DATABASE_URL=postgresql+asyncpg://ats:change-me@db:5432/ats

# Postgres container (must match DATABASE_URL)
POSTGRES_USER=ats
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ats

# --- AI providers -----------------------------------------------------------------------------
# The LLM and the embeddings are configured independently. Switching provider is a change to
# these variables only. Hosted providers receive the text of your resume; a local server does not.
# Without LLM_PROVIDER the API still runs; only POST /resumes/{id}/process answers 503
# `ai_not_configured`.
#
# LLM_PROVIDER: anthropic | openai | openai_compatible (Ollama, LM Studio, vLLM, ...)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Required for openai_compatible, optional for openai.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=120
# 0 by default. Leave the value empty (LLM_TEMPERATURE=) to never send a temperature.
LLM_TEMPERATURE=0

# EMBEDDING_PROVIDER: local | openai | openai_compatible. Multilingual (Portuguese + English)
# models only. EMBEDDING_DIMENSION is the size of the database column (1-2000): changing the
# model or the dimension later needs the procedure in the README ("Changing the embedding model").
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_API_KEY=
# From inside Docker Compose a server on your machine is host.docker.internal; on the host
# machine itself use localhost.
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1

# Example 1: Anthropic for the LLM (Anthropic has no embeddings: keep the local ones).
# LLM_PROVIDER=anthropic
# LLM_MODEL=<an Anthropic model id>
# LLM_API_KEY=<your-anthropic-api-key>

# Example 2: OpenAI for both. text-embedding-3-small is reduced to the column size by `dimensions`.
# LLM_PROVIDER=openai
# LLM_MODEL=<an OpenAI model id>
# LLM_API_KEY=<your-openai-api-key>
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1024
# EMBEDDING_API_KEY=<your-openai-api-key>
# EMBEDDING_BASE_URL=

# Example 3: everything local with Ollama running on your machine (nothing leaves it).
# `ollama pull bge-m3` and `ollama pull <model>`; start Ollama with OLLAMA_HOST=0.0.0.0 so the
# container can reach it (see the README).
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=<an Ollama model name>
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_MODEL=bge-m3
