# Copy to .env and adjust. Placeholders only: never commit real secrets.

# Application
APP_ENV=local
LOG_LEVEL=INFO
# Resume uploads: maximum size in bytes (5 MB) and where original files are kept.
# Docker Compose overrides the directory with its persistent volume (/data/resumes).
RESUME_MAX_UPLOAD_BYTES=5242880
RESUME_STORAGE_DIR=data/resumes
# Inside Docker Compose the database host is "db". On the host machine use "localhost".
DATABASE_URL=postgresql+asyncpg://ats:change-me@db:5432/ats

# Postgres container (must match DATABASE_URL)
POSTGRES_USER=ats
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ats

# --- AI providers -----------------------------------------------------------------------------
# The LLM and the embeddings are configured independently. Switching provider is a change to
# these variables only. Hosted providers receive the text of your resume; a local server does not.
# Without LLM_PROVIDER the API still runs; only POST /resumes/{id}/process answers 503
# `ai_not_configured`.
#
# LLM_PROVIDER: anthropic | openai | openai_compatible (Ollama, LM Studio, vLLM, ...)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Required for openai_compatible, optional for openai.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=120
# 0 by default. Leave the value empty (LLM_TEMPERATURE=) to never send a temperature.
LLM_TEMPERATURE=0

# EMBEDDING_PROVIDER: local | openai | openai_compatible. Multilingual (Portuguese + English)
# models only. EMBEDDING_DIMENSION is the size of the database column (1-2000): changing the
# model or the dimension later needs the procedure in the README ("Changing the embedding model").
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_API_KEY=
# From inside Docker Compose a server on your machine is host.docker.internal; on the host
# machine itself use localhost.
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1

# Gap analysis (POST /analyses). ANALYSIS_TOP_K: resume chunks kept per requirement (1-20).
# ANALYSIS_MIN_SIMILARITY: lowest cosine similarity (0-1) a chunk may have. The right value
# depends on the embedding model: tune it with the evals (too high: many "missing"; too low:
# more LLM calls).
# ANALYSIS_MAX_REQUIREMENTS_PER_CALL: requirements per LLM call (1-50).
# ANALYSIS_MAX_LLM_CALLS: LLM calls one analysis may make (1-100).
ANALYSIS_TOP_K=5
ANALYSIS_MIN_SIMILARITY=0.4
ANALYSIS_MAX_REQUIREMENTS_PER_CALL=8
ANALYSIS_MAX_LLM_CALLS=10

# Score and report (GET /analyses/{id}/report). The score is 0-100: the weighted coverage of the
# must-haves, the nice-to-haves and the ATS keywords, minus a penalty per resume parsing issue.
# The three weights are relative (they are scaled to add up to one); at least one must be above 0.
# SCORE_PARTIAL_CREDIT: the share of a requirement a `partial` verdict earns (0-1).
# The penalties are points taken off for each issue of that severity (0-100).
# The thresholds are on the 0-100 scale: at or above the pass threshold is `likely_pass`, at or
# above the borderline threshold `borderline`, below it `likely_reject`; borderline must be lower.
# The score is computed when the report is read, so changing these needs no new LLM calls.
SCORE_WEIGHT_MUST_HAVE=0.6
SCORE_WEIGHT_NICE_TO_HAVE=0.15
SCORE_WEIGHT_KEYWORDS=0.25
SCORE_PARTIAL_CREDIT=0.5
SCORE_PENALTY_CRITICAL=40
SCORE_PENALTY_WARNING=5
SCORE_PENALTY_INFO=1
SCORE_PASS_THRESHOLD=70
SCORE_BORDERLINE_THRESHOLD=50
# SCREENER_RUNS: how many times the simulated first-pass screener runs (1-10). More runs cost
# more LLM calls and show how much the answers agree.
SCREENER_RUNS=3
# REPORT_MAX_SUGGESTIONS: the most rewrite suggestions asked for, in one LLM call (0-30; 0 = none).
REPORT_MAX_SUGGESTIONS=8

# Example 1: Anthropic for the LLM (Anthropic has no embeddings: keep the local ones).
# LLM_PROVIDER=anthropic
# LLM_MODEL=<an Anthropic model id>
# LLM_API_KEY=<your-anthropic-api-key>

# Example 2: OpenAI for both. text-embedding-3-small is reduced to the column size by `dimensions`.
# LLM_PROVIDER=openai
# LLM_MODEL=<an OpenAI model id>
# LLM_API_KEY=<your-openai-api-key>
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1024
# EMBEDDING_API_KEY=<your-openai-api-key>
# EMBEDDING_BASE_URL=

# Example 3: everything local with Ollama running on your machine (nothing leaves it).
# `ollama pull bge-m3` and `ollama pull <model>`; start Ollama with OLLAMA_HOST=0.0.0.0 so the
# container can reach it (see the README).
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=<an Ollama model name>
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_MODEL=bge-m3

# Evals (`uv run --env-file .env python -m evals.run`): run locally against your real providers,
# never in CI. They spend tokens and send the synthetic cases to the configured provider.
# EVAL_RUNS: times the analysis is repeated per case (1-10; --runs overrides it).
# The thresholds are 0-1 and are a starting point to tune: the run exits with an error below them
# (any fabricated evidence always fails).
EVAL_RUNS=3
EVAL_MIN_VERDICT_ACCURACY=0.8
EVAL_MIN_OUTCOME_ACCURACY=0.75
EVAL_MIN_CONSISTENCY=0.9
