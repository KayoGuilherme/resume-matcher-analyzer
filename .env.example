# Copy to .env and adjust. Placeholders only: never commit real secrets.

# Application
APP_ENV=local
LOG_LEVEL=INFO
# Resume uploads: maximum size in bytes (5 MB) and where original files are kept.
# Docker Compose overrides the directory with its persistent volume (/data/resumes).
RESUME_MAX_UPLOAD_BYTES=5242880
RESUME_STORAGE_DIR=data/resumes
# Inside Docker Compose the database host is "db". On the host machine use "localhost".
DATABASE_URL=postgresql+asyncpg://ats:change-me@db:5432/ats

# Postgres container (must match DATABASE_URL)
POSTGRES_USER=ats
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ats
